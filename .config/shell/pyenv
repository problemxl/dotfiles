# ~/.config/shell/pyenv — per-user Python versions (pyenv)  [bash + zsh]

# Nothing to do if pyenv isn't installed
command -v pyenv >/dev/null 2>&1 || return

export PYENV_ROOT="$HOME/.pyenv"

# Prepend shims so the active Python resolves first, enable completions.
# --no-push-path keeps PATH tidy (adds shims once, ahead of everything else).
if [ -n "$BASH_VERSION" ]; then
    eval "$(pyenv init - bash --no-push-path)"
elif [ -n "$ZSH_VERSION" ]; then
    eval "$(pyenv init - zsh --no-push-path)"
fi
