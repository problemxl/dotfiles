# ~/.ssh/config — shared client config (tracked in dotfiles)
#
# Host blocks below reference pubkey FILES; the private half comes from your
# local agent (Bitwarden/Vaultwarden SSH agent, ssh-agent, etc.).
# Per-device pubkeys live in ~/.ssh/keys/<device>.pub — also tracked here.

Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    HashKnownHosts no

# --- envs --------------------------------------------------------------------
# Edit HostName/Port to match how each env is exposed, then `ssh env1` works.

# Host env1
#     HostName env1.example.com
#     Port 22
#     User root
#     IdentityFile ~/.ssh/keys/desktop-arch-linux.pub

# Reach a second env through the first (ProxyJump keeps private keys off
# the jump host entirely):

# Host env2
#     HostName 10.0.0.2
#     User root
#     ProxyJump env1
#     IdentityFile ~/.ssh/keys/desktop-arch-linux.pub
